{
  "name": "bff",
  "domain": "bff",
  "path": "../../bff",
  "glob": "src/**/*.ts",
  "useCase": {
    "find": "classes",
    "where": { "nameEndsWith": { "suffix": "UseCase" } },
    "extract": {
      "useCaseName": { "fromClassName": true }
    }
  },
  "eventHandler": { "notUsed": true },
  "domainOp": { "notUsed": true },
  "api": {
    "find": "classes",
    "where": { "hasJSDoc": { "tag": "bffApi" } },
    "extract": {
      "apiType": { "literal": "REST" },
      "route": { "fromProperty": { "name": "route", "kind": "instance" } },
      "method": { "fromProperty": { "name": "method", "kind": "instance" } }
    }
  },
  "event": { "notUsed": true },
  "ui": { "notUsed": true },
  "customTypes": {
    "httpCall": {
      "find": "methods",
      "where": { "inClassWith": { "hasJSDoc": { "tag": "httpClient" } } },
      "extract": {
        "serviceName": { "fromProperty": { "name": "serviceName", "kind": "instance" } },
        "route": { "fromProperty": { "name": "route", "kind": "instance" } }
      }
    }
  }
}
